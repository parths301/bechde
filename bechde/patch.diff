+  if (!me) throw new Error("Not signed in");
+  const { error } = await getSupabaseBrowser().from("reports").insert({
+    reporter_id: me,
+    review_id: reviewId,
+    reason,
+    details,
+  });
+  if (error) throw error;
+}
