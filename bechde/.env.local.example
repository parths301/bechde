# Copy to .env.local and fill in. See README.md §2 for the full local setup.

# Required — from `npx supabase status -o env` after `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional locally. Auth emails (magic link / code) go to Mailpit regardless —
# this only gates the app's own notification emails (chat digests, saved
# searches). Unset means sendMail() throws instead of pretending to send.
RESEND_API_KEY=
EMAIL_FROM=

# Optional locally. Required in production — cron routes fail closed without it.
CRON_SECRET=

# Optional. Falls back to a hardcoded bechde.app URL if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Sentry stays inert without a DSN.
NEXT_PUBLIC_SENTRY_DSN=
